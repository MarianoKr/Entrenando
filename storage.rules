rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /usuarios/{uid}/{allPaths=**} {
      allow read: if request.auth != null
        && (request.auth.uid == uid
            || request.auth.token.rol == 'profesor'
            || request.auth.token.rol == 'admin');
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024; // 10MB máx por archivo
    }
    // Contenido curado (ej. gifs/fotos de ejerciciosGlobales): solo admin escribe.
    match /contenido-global/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.rol == 'admin';
    }
  }
}
